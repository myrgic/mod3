{
  "name": "shake",
  "description": "head shake, no",
  "args": {
    "times": {
      "default": 2,
      "min": 1,
      "max": 4
    },
    "depth": {
      "default": 0.5,
      "min": 0.1,
      "max": 1
    }
  },
  "duration_ms": "600*times+150",
  "fade_ms": 120,
  "tracks": {
    "head.x": {
      "wave": {
        "amp": "depth",
        "period_ms": 600
      }
    },
    "eyes.x": {
      "follow": {
        "of": "head.x",
        "gain": -0.4
      }
    }
  }
}
