{
  "name": "nod",
  "description": "one or more nods",
  "args": {
    "times": {
      "default": 2,
      "min": 1,
      "max": 4
    },
    "depth": {
      "default": 0.5,
      "min": 0.1,
      "max": 1
    }
  },
  "duration_ms": "500*times+200",
  "fade_ms": 120,
  "tracks": {
    "head.y": {
      "wave": {
        "shape": "sin",
        "amp": "-depth",
        "period_ms": 500,
        "phase": 0
      }
    },
    "eyes.y": {
      "follow": {
        "of": "head.y",
        "gain": -0.3
      }
    }
  }
}
